# Copier ce fichier en `.streamlit/secrets.toml` (jamais envoyé sur GitHub) et y mettre les vraies clés.
# En ligne, les mêmes lignes se collent dans Streamlit Community Cloud : Settings > Secrets.
# Une seule clé suffit. Avec les deux, Flamy répond avec Claude et garde Gemini en secours.

# Clé de l'API d'Anthropic (Claude), créée sur https://console.anthropic.com (commence par "sk-ant-").
ANTHROPIC_API_KEY = "à-remplacer"
# Facultatif : un autre modèle de Claude que "claude-haiku-5-5", par exemple "claude-sonnet-5-5" (plus cher).
# CLAUDE_MODEL = "claude-sonnet-5-5"

# Clé de l'API Gemini (Google AI Studio).
LLM_API_KEY = "à-remplacer"
