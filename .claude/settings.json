{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run verifier:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run check-submission:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" python -m space_apps_kit.regles claude-bash"
          }
        ]
      }
    ]
  }
}
